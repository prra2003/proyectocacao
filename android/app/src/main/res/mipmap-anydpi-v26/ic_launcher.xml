<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptable: Android compone el fondo y la figura, y recorta la forma
     (círculo, cuadrado redondeado, gota) según la marca del teléfono. Sin
     esto, el sistema mete el PNG dentro de un círculo blanco y lo encoge. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/fondo_icono"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
